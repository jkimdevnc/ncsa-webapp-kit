# One origin for the browser: the built app, and /api passed to the API (docs/decisions/0004).
# Plain HTTP on :8080; TLS comes from the Ingress in Stage 2.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# The built app; unknown paths fall back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
