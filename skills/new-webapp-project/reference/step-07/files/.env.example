# Copy to .env (git-ignored) and adjust. Every value has a working default for local development.

# Redis connection used by the API.
#REDIS_URL=redis://localhost:6379/0

# API log level (logs go to stdout).
#LOG_LEVEL=INFO

# How long an analysis result stays in Redis before it expires (seconds). Default: 24 hours.
#RESULT_TTL_SECONDS=86400

# Where trained model artifacts are read from (`make model` writes there). Default: backend/ml_artifacts.
# Use an absolute path: a relative one is read from the directory the API starts in.
#ARTIFACT_DIR=/absolute/path/to/ml_artifacts
